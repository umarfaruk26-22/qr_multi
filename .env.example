# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev_secret_key_change_in_production_987654321

# Base URL for public profiles & QR routing
BASE_URL=http://127.0.0.1:5000

# MySQL Database Configuration (XAMPP default port 3306, user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=employee_qr_system
DB_USER=root
DB_PASSWORD=

# Upload Configuration
MAX_CONTENT_LENGTH=5242880 # 5MB in bytes
UPLOAD_FOLDER=uploads

# Google Gemini AI Configuration for GMB Review Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
